{
  "name": "favlock-app",
  "private": true,
  "version": "1.14.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "dashboard",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w dashboard",
    "dev:chrome": "node scripts/configure-chrome-extension.mjs",
    "dev:firefox": "npm run build:app-dist:development --prefix extensions/firefox",
    "build": "npm run build -w dashboard",
    "build:chrome": "node scripts/pack-chrome-extension.mjs",
    "build:firefox": "npm run build:app-dist --prefix extensions/firefox",
    "lint": "npm run lint -w dashboard",
    "test": "npm run test -w dashboard && npm run test:chrome",
    "test:chrome": "FAVLOCK_USE_TEST_ENV=1 node scripts/configure-chrome-extension.mjs && vitest run extensions/chrome && npm run test:chrome-browser",
    "test:chrome-browser": "node scripts/test-chrome-highlight-browser.mjs",
    "test:firefox": "npm test --prefix extensions/firefox",
    "test:firefox-browser": "npm run test:browser --prefix extensions/firefox"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "vitest": "5.0.0"
  }
}
