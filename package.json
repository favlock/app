{
  "name": "favlock-app",
  "private": true,
  "version": "1.5.1",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "dashboard",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w dashboard",
    "dev:chrome": "node scripts/configure-chrome-extension.mjs",
    "build": "npm run build -w dashboard",
    "build:chrome": "node scripts/pack-chrome-extension.mjs",
    "lint": "npm run lint -w dashboard",
    "test": "npm run test -w dashboard && npm run test:chrome",
    "test:chrome": "FAVLOCK_USE_TEST_ENV=1 node scripts/configure-chrome-extension.mjs && vitest run extensions/chrome"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "vitest": "4.1.9"
  }
}
